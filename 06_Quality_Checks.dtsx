<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:refId="Package"
  DTS:CreationDate="8/13/2026 9:04:03 PM"
  DTS:CreationName="Microsoft.Package"
  DTS:CreatorComputerName="DESKTOP-H10OCSF"
  DTS:CreatorName="DESKTOP-H10OCSF\AL"
  DTS:DTSID="{302EE9E8-C2CB-4DB2-AF52-EE9B0E73A9A5}"
  DTS:ExecutableType="Microsoft.Package"
  DTS:LastModifiedProductVersion="16.0.5228.0"
  DTS:LocaleID="1036"
  DTS:ObjectName="Package1"
  DTS:PackageType="5"
  DTS:VersionBuild="3"
  DTS:VersionGUID="{AFBE6E1C-CBFD-4E44-A357-36EEBD55B5C5}">
  <DTS:Property
    DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\SQL_Quality_Check"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tâche d'exécution de requêtes SQL"
      DTS:DTSID="{BBD1626C-08AD-4C7A-88AE-51C4859CA7B3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Quality_Check"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8F3B7821-4889-4EC0-9716-1027879958C8}"
          SQLTask:SqlStatementSource="USE DW_Universite_BI;&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;DECLARE @QC TABLE&#xA;(&#xA;    controle      NVARCHAR(200),&#xA;    categorie     NVARCHAR(50),&#xA;    severite      VARCHAR(10),&#xA;    nb_anomalies  BIGINT,&#xA;    attendu       NVARCHAR(100)&#xA;);&#xA;&#xA;/* ============================================================&#xA;   1. VOLUMES&#xA;   ============================================================ */&#xA;&#xA;PRINT '========================================';&#xA;PRINT '1. VOLUMES DU DATA WAREHOUSE';&#xA;PRINT '========================================';&#xA;&#xA;SELECT 'Dim_Etudiant' AS objet, COUNT_BIG(*) AS nb&#xA;FROM dw.Dim_Etudiant&#xA;&#xA;UNION ALL&#xA;SELECT 'Dim_Formation', COUNT_BIG(*)&#xA;FROM dw.Dim_Formation&#xA;&#xA;UNION ALL&#xA;SELECT 'Dim_UE', COUNT_BIG(*)&#xA;FROM dw.Dim_UE&#xA;&#xA;UNION ALL&#xA;SELECT 'Dim_Date', COUNT_BIG(*)&#xA;FROM dw.Dim_Date&#xA;&#xA;UNION ALL&#xA;SELECT 'Fact_Inscription', COUNT_BIG(*)&#xA;FROM dw.Fact_Inscription&#xA;&#xA;UNION ALL&#xA;SELECT 'Fact_ResultatUE', COUNT_BIG(*)&#xA;FROM dw.Fact_ResultatUE&#xA;&#xA;UNION ALL&#xA;SELECT 'Fact_Paiement', COUNT_BIG(*)&#xA;FROM dw.Fact_Paiement;&#xA;&#xA;&#xA;/* ============================================================&#xA;   2. TABLES VIDES&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Inscription vide',&#xA;    'VOLUME',&#xA;    'ERROR',&#xA;    CASE WHEN COUNT_BIG(*) = 0 THEN 1 ELSE 0 END,&#xA;    '&gt; 0'&#xA;FROM dw.Fact_Inscription;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_ResultatUE vide',&#xA;    'VOLUME',&#xA;    'ERROR',&#xA;    CASE WHEN COUNT_BIG(*) = 0 THEN 1 ELSE 0 END,&#xA;    '&gt; 0'&#xA;FROM dw.Fact_ResultatUE;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Paiement vide',&#xA;    'VOLUME',&#xA;    'ERROR',&#xA;    CASE WHEN COUNT_BIG(*) = 0 THEN 1 ELSE 0 END,&#xA;    '&gt; 0'&#xA;FROM dw.Fact_Paiement;&#xA;&#xA;&#xA;/* ============================================================&#xA;   3. DOUBLONS DES DIMENSIONS&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Plusieurs versions actuelles du même étudiant',&#xA;    'DOUBLON',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM&#xA;(&#xA;    SELECT matricule&#xA;    FROM dw.Dim_Etudiant&#xA;    WHERE est_actuel = 1&#xA;    GROUP BY matricule&#xA;    HAVING COUNT(*) &gt; 1&#xA;) x;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Doublons code_formation',&#xA;    'DOUBLON',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM&#xA;(&#xA;    SELECT code_formation&#xA;    FROM dw.Dim_Formation&#xA;    WHERE formation_key &lt;&gt; -1&#xA;    GROUP BY code_formation&#xA;    HAVING COUNT(*) &gt; 1&#xA;) x;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Doublons code_ue',&#xA;    'DOUBLON',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM&#xA;(&#xA;    SELECT code_ue&#xA;    FROM dw.Dim_UE&#xA;    WHERE ue_key &lt;&gt; -1&#xA;    GROUP BY code_ue&#xA;    HAVING COUNT(*) &gt; 1&#xA;) x;&#xA;&#xA;&#xA;/* ============================================================&#xA;   4. DOUBLONS DES TABLES DE FAIT&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Doublons id_inscription',&#xA;    'DOUBLON',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM&#xA;(&#xA;    SELECT id_inscription&#xA;    FROM dw.Fact_Inscription&#xA;    GROUP BY id_inscription&#xA;    HAVING COUNT(*) &gt; 1&#xA;) x;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Doublons note_id',&#xA;    'DOUBLON',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM&#xA;(&#xA;    SELECT note_id&#xA;    FROM dw.Fact_ResultatUE&#xA;    GROUP BY note_id&#xA;    HAVING COUNT(*) &gt; 1&#xA;) x;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Doublons paiement_id',&#xA;    'DOUBLON',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM&#xA;(&#xA;    SELECT paiement_id&#xA;    FROM dw.Fact_Paiement&#xA;    GROUP BY paiement_id&#xA;    HAVING COUNT(*) &gt; 1&#xA;) x;&#xA;&#xA;&#xA;/* ============================================================&#xA;   5. INTEGRITE : FACT_INSCRIPTION&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Inscription -&gt; Dim_Etudiant',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Inscription f&#xA;LEFT JOIN dw.Dim_Etudiant d&#xA;       ON d.etudiant_key = f.etudiant_key&#xA;WHERE d.etudiant_key IS NULL;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Inscription -&gt; Dim_Formation',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Inscription f&#xA;LEFT JOIN dw.Dim_Formation d&#xA;       ON d.formation_key = f.formation_key&#xA;WHERE d.formation_key IS NULL;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Inscription -&gt; Dim_Date',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Inscription f&#xA;LEFT JOIN dw.Dim_Date d&#xA;       ON d.date_key = f.date_inscription_key&#xA;WHERE d.date_key IS NULL;&#xA;&#xA;&#xA;/* ============================================================&#xA;   6. INTEGRITE : FACT_RESULTATUE&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_ResultatUE -&gt; Dim_Etudiant',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_ResultatUE f&#xA;LEFT JOIN dw.Dim_Etudiant d&#xA;       ON d.etudiant_key = f.etudiant_key&#xA;WHERE d.etudiant_key IS NULL;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_ResultatUE -&gt; Dim_Formation',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_ResultatUE f&#xA;LEFT JOIN dw.Dim_Formation d&#xA;       ON d.formation_key = f.formation_key&#xA;WHERE d.formation_key IS NULL;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_ResultatUE -&gt; Dim_UE',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_ResultatUE f&#xA;LEFT JOIN dw.Dim_UE d&#xA;       ON d.ue_key = f.ue_key&#xA;WHERE d.ue_key IS NULL;&#xA;&#xA;&#xA;/* ============================================================&#xA;   7. COHERENCE UE / FORMATION&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Formation du résultat différente de celle de UE',&#xA;    'COHERENCE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_ResultatUE f&#xA;JOIN dw.Dim_UE u&#xA;  ON u.ue_key = f.ue_key&#xA;WHERE f.formation_key &lt;&gt; u.formation_key;&#xA;&#xA;&#xA;/* ============================================================&#xA;   8. QUALITE DES NOTES&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Notes hors domaine [0,20]',&#xA;    'METIER',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_ResultatUE&#xA;WHERE note IS NOT NULL&#xA;  AND (note &lt; 0 OR note &gt; 20);&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Note NULL sans absence',&#xA;    'METIER',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_ResultatUE&#xA;WHERE note IS NULL&#xA;  AND est_absent = 0;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Résultat valide mais étudiant absent',&#xA;    'METIER',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_ResultatUE&#xA;WHERE est_valide = 1&#xA;  AND est_absent = 1;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Résultat valide avec note &lt; 10',&#xA;    'METIER',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_ResultatUE&#xA;WHERE est_valide = 1&#xA;  AND (note IS NULL OR note &lt; 10);&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Résultat non valide malgré note &gt;= 10',&#xA;    'METIER',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_ResultatUE&#xA;WHERE est_absent = 0&#xA;  AND note &gt;= 10&#xA;  AND est_valide = 0;&#xA;&#xA;&#xA;/* ============================================================&#xA;   9. INTEGRITE : FACT_PAIEMENT&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Paiement -&gt; Dim_Etudiant',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Paiement f&#xA;LEFT JOIN dw.Dim_Etudiant d&#xA;       ON d.etudiant_key = f.etudiant_key&#xA;WHERE d.etudiant_key IS NULL;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Paiement -&gt; Dim_Formation',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Paiement f&#xA;LEFT JOIN dw.Dim_Formation d&#xA;       ON d.formation_key = f.formation_key&#xA;WHERE d.formation_key IS NULL;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Paiement -&gt; Dim_Date',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Paiement f&#xA;LEFT JOIN dw.Dim_Date d&#xA;       ON d.date_key = f.date_paiement_key&#xA;WHERE d.date_key IS NULL;&#xA;&#xA;&#xA;/* ============================================================&#xA;   10. PAIEMENT -&gt; INSCRIPTION&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Paiement sans inscription correspondante',&#xA;    'INTEGRITE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Paiement p&#xA;LEFT JOIN dw.Fact_Inscription i&#xA;       ON i.id_inscription = p.id_inscription&#xA;WHERE i.id_inscription IS NULL;&#xA;&#xA;&#xA;/* ============================================================&#xA;   11. COHERENCE DES CLES DU PAIEMENT&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Etudiant paiement différent de inscription',&#xA;    'COHERENCE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Paiement p&#xA;JOIN dw.Fact_Inscription i&#xA;  ON i.id_inscription = p.id_inscription&#xA;WHERE p.etudiant_key &lt;&gt; i.etudiant_key;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Formation paiement différente de inscription',&#xA;    'COHERENCE',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Paiement p&#xA;JOIN dw.Fact_Inscription i&#xA;  ON i.id_inscription = p.id_inscription&#xA;WHERE p.formation_key &lt;&gt; i.formation_key;&#xA;&#xA;&#xA;/* ============================================================&#xA;   12. MONTANTS&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Paiements négatifs',&#xA;    'METIER',&#xA;    'ERROR',&#xA;    COUNT_BIG(*),&#xA;    '0'&#xA;FROM dw.Fact_Paiement&#xA;WHERE montant &lt; 0;&#xA;&#xA;&#xA;/* Zéro = warning, car la contrainte SQL actuelle autorise 0 */&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Paiements de montant zéro',&#xA;    'METIER',&#xA;    'WARNING',&#xA;    COUNT_BIG(*),&#xA;    'À vérifier'&#xA;FROM dw.Fact_Paiement&#xA;WHERE montant = 0;&#xA;&#xA;&#xA;/* ============================================================&#xA;   13. MEMBRES UNKNOWN&#xA;   ============================================================ */&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Inscription : étudiant UNKNOWN',&#xA;    'UNKNOWN',&#xA;    'WARNING',&#xA;    COUNT_BIG(*),&#xA;    'À analyser'&#xA;FROM dw.Fact_Inscription&#xA;WHERE etudiant_key = -1;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Inscription : formation UNKNOWN',&#xA;    'UNKNOWN',&#xA;    'WARNING',&#xA;    COUNT_BIG(*),&#xA;    'À analyser'&#xA;FROM dw.Fact_Inscription&#xA;WHERE formation_key = -1;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_ResultatUE : étudiant UNKNOWN',&#xA;    'UNKNOWN',&#xA;    'WARNING',&#xA;    COUNT_BIG(*),&#xA;    'À analyser'&#xA;FROM dw.Fact_ResultatUE&#xA;WHERE etudiant_key = -1;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_ResultatUE : UE UNKNOWN',&#xA;    'UNKNOWN',&#xA;    'WARNING',&#xA;    COUNT_BIG(*),&#xA;    'À analyser'&#xA;FROM dw.Fact_ResultatUE&#xA;WHERE ue_key = -1;&#xA;&#xA;&#xA;INSERT INTO @QC&#xA;SELECT&#xA;    'Fact_Paiement : étudiant UNKNOWN',&#xA;    'UNKNOWN',&#xA;    'WARNING',&#xA;    COUNT_BIG(*),&#xA;    'À analyser'&#xA;FROM dw.Fact_Paiement&#xA;WHERE etudiant_key = -1;&#xA;&#xA;&#xA;/* ============================================================&#xA;   14. RESULTAT DU QUALITY CHECK&#xA;   ============================================================ */&#xA;&#xA;SELECT&#xA;    controle,&#xA;    categorie,&#xA;    severite,&#xA;    nb_anomalies,&#xA;    attendu,&#xA;    CASE&#xA;        WHEN nb_anomalies = 0 THEN 'OK'&#xA;        WHEN severite = 'WARNING' THEN 'WARNING'&#xA;        ELSE 'FAILED'&#xA;    END AS statut&#xA;FROM @QC&#xA;ORDER BY&#xA;    CASE severite&#xA;        WHEN 'ERROR' THEN 1&#xA;        ELSE 2&#xA;    END,&#xA;    categorie,&#xA;    controle;&#xA;&#xA;&#xA;/* ============================================================&#xA;   15. DIAGNOSTIC : afficher uniquement les anomalies&#xA;   ============================================================ */&#xA;&#xA;SELECT&#xA;    controle,&#xA;    categorie,&#xA;    severite,&#xA;    nb_anomalies,&#xA;    attendu,&#xA;    CASE&#xA;        WHEN nb_anomalies = 0 THEN 'OK'&#xA;        WHEN severite = 'WARNING' THEN 'WARNING'&#xA;        ELSE 'FAILED'&#xA;    END AS statut&#xA;FROM @QC&#xA;WHERE nb_anomalies &gt; 0&#xA;ORDER BY&#xA;    CASE severite&#xA;        WHEN 'ERROR' THEN 1&#xA;        ELSE 2&#xA;    END,&#xA;    nb_anomalies DESC;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
  <DTS:DesignTimeProperties><![CDATA[<?xml version="1.0"?>
