      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8F3B7821-4889-4EC0-9716-1027879958C8}"
          SQLTask:SqlStatementSource="INSERT INTO audit.ETL_Run&#xA;(&#xA;    package_name,&#xA;    date_debut,&#xA;    statut&#xA;)&#xA;VALUES&#xA;(&#xA;    '02C_Load_Dimensions',&#xA;    SYSDATETIME(),&#xA;    'RUNNING'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
