      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8F3B7821-4889-4EC0-9716-1027879958C8}"
          SQLTask:SqlStatementSource="UPDATE audit.ETL_Run&#xA;SET&#xA;    date_fin = SYSDATETIME(),&#xA;    statut = 'SUCCESS'&#xA;WHERE run_id =&#xA;(&#xA;    SELECT MAX(run_id)&#xA;    FROM audit.ETL_Run&#xA;    WHERE package_name = '02C_Load_Dimensions'&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
