                  name="ABSENT_SANS_NOTE"
                  synchronousInputId="Package\DFT_Fact_ResultatUEs\CS_Note.Inputs[Entrée de fractionnement conditionnel]"
                  truncationRowDisposition="RedirectRow">
                  <properties>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Spécifie l'expression. Cette version d'expression utilise les identificateurs de traçabilité à la place des noms de colonnes."
                      name="Expression">[UPPER]([TRIM](#{Package\DFT_Fact_ResultatUEs\Staging_Notes.Outputs[Sortie de source OLE DB].Columns[absence_examen]})) == "OUI" || [UPPER]([TRIM](#{Package\DFT_Fact_ResultatUEs\Staging_Notes.Outputs[Sortie de source OLE DB].Columns[absence_examen]})) == "TRUE" || [TRIM](#{Package\DFT_Fact_ResultatUEs\Staging_Notes.Outputs[Sortie de source OLE DB].Columns[absence_examen]}) == "1"</property>
