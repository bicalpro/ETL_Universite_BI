                      name="Expression">[TRIM](#{Package\DFT_Fact_ResultatUEs\DC_Clean.Outputs[Sortie de colonne dérivée].Columns[note_clean]}) == ""</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Spécifie la version claire de l'expression. Cette version d'expression utilise les noms de colonnes."
                      expressionType="Notify"
                      name="FriendlyExpression">TRIM(note_clean) == ""</property>
                    <property
                      dataType="System.Int32"
